# Copy to apps/web/.env.local for local development; set the same keys in your host (e.g. Vercel) for production.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.

APP_ENV=development

# --- Football data (server only) ---
# api_football (https://www.api-football.com) or football_data (https://www.football-data.org)
FOOTBALL_DATA_PROVIDER=api_football
FOOTBALL_API_KEY=
# Optional: comma-separated provider competition ids (defaults: top European leagues for the provider)
FOOTBALL_COMPETITIONS=
# Optional: force a season year (default: Aug–Jul European season)
FOOTBALL_SEASON=
# Optional: override the provider's daily request budget used for quota protection
FOOTBALL_DAILY_LIMIT=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security — never expose to the browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduled jobs (server only) ---
# Random string of 16+ chars, e.g. `openssl rand -hex 24`. Vercel Cron and GitHub Actions send it as a bearer token.
CRON_SECRET=

# --- Push notifications (server only, optional) ---
# Only needed if you enable "enhanced push security" in your Expo account.
EXPO_ACCESS_TOKEN=
